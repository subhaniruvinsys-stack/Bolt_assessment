# Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Server port (Railway auto-sets this)
PORT=8080

# Frontend origin for CORS (set to your Vercel URL in production)
CORS_ORIGIN=https://your-app.vercel.app

# Session secret — any random string
SESSION_SECRET=bolt_dev_secret_key_12345

# Set to "true" in production for cross-origin cookies (Vercel → Railway)
SECURE_COOKIES=true

# Razorpay Test Mode Credentials
